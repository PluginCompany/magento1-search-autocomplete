<?xml version="1.0"?>
<config>
    <modules>
        <Plugincompany_Autocomplete>
            <version>1.14.4</version>
        </Plugincompany_Autocomplete>
    </modules>
    <global>
        <resources>
            <plugincompany_autocomplete_setup>
                <setup>
                    <module>Plugincompany_Autocomplete</module>
                    <class>Plugincompany_Autocomplete_Model_Resource_Setup</class>
                </setup>
            </plugincompany_autocomplete_setup>
        </resources>
        <helpers>
            <plugincompany_autocomplete>
                <class>Plugincompany_Autocomplete_Helper</class>
            </plugincompany_autocomplete>
        </helpers>
        <models>
            <plugincompany_autocomplete>
                <class>Plugincompany_Autocomplete_Model</class>
            </plugincompany_autocomplete>
        </models>
        <blocks>
            <plugincompany_autocomplete>
                <class>Plugincompany_Autocomplete_Block</class>
            </plugincompany_autocomplete>
        </blocks>
    </global>
    <frontend>
        <translate>
            <modules>
                <Plugincompany_Autocomplete>
                    <files>
                        <default>Plugincompany_Autocomplete.csv</default>
                    </files>
                </Plugincompany_Autocomplete>
            </modules>
        </translate>
        <layout>
            <updates>
                <autocom>
                    <file>plugincompany_autocomplete.xml</file>
                </autocom>
            </updates>
        </layout>
        <routers>
            <searchautocomplete>
                <use>standard</use>
                <args>
                    <module>Plugincompany_Autocomplete</module>
                    <frontName>searchautocomplete</frontName>
                </args>
            </searchautocomplete>
        </routers>
    </frontend>
    <adminhtml>
        <translate>
            <modules>
                <Plugincompany_Contactforms>
                    <files>
                        <default>Plugincompany_Autocomplete.csv</default>
                    </files>
                </Plugincompany_Contactforms>
            </modules>
        </translate>
        <layout>
            <updates>
                <plugincompany_autocomplete>
                    <file>plugincompany_autocomplete.xml</file>
                </plugincompany_autocomplete>
            </updates>
        </layout>
        <events>
            <adminhtml_cms_page_edit_tab_main_prepare_form>
                <observers>
                    <plugincompany_autocomplete>
                        <type>model</type>
                        <class>Plugincompany_Autocomplete_Model_Observer</class>
                        <method>adminhtmlCmsPageEditTabMainPrepareForm</method>
                    </plugincompany_autocomplete>
                </observers>
            </adminhtml_cms_page_edit_tab_main_prepare_form>
            <controller_action_predispatch>
                <observers>
                    <plugincompany_autocomplete>
                        <type>model</type>
                        <class>plugincompany_autocomplete/observer</class>
                        <method>controllerActionPredispatch</method>
                    </plugincompany_autocomplete>
                </observers>
            </controller_action_predispatch>
        </events>
    </adminhtml>
    <admin>
        <routers>
            <adminhtml>
                <use>admin</use>
                <args>
                    <modules>
                        <plugincompany_autocomplete before="Mage_Adminhtml">Plugincompany_Autocomplete_Adminhtml</plugincompany_autocomplete>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
    <default>
        <plugincompany_autocomplete>
            <general>
                <enable>1</enable>
                <jquery>1</jquery>
                <input_selector>#search</input_selector>
                <input_selector_mobile>#search</input_selector_mobile>
                <mobile_media_query_width>720</mobile_media_query_width>
                <theme>2</theme>
                <srwidth>200</srwidth>
                <imagesize>200</imagesize>
                <search_display>auto</search_display>
                <imagetype>thumbnail</imagetype>
                <productlimit>3</productlimit>
                <show_price>0</show_price>
                <show_price_tax>0</show_price_tax>
                <categories>1</categories>
                <categorylimit>3</categorylimit>
                <cms_pages>1</cms_pages>
                <cmslimit>3</cmslimit>
                <listdesign>design-grid-3</listdesign>
                <highlight>0</highlight>
                <pre_render_images>1</pre_render_images>
            </general>
            <search>
                <title>name</title>
                <description>short_description</description>
                <description_limit>100</description_limit>
                <sku>1</sku>
                <attribute_priority>title,description,keywords</attribute_priority>
                <sort_min_query_length>0</sort_min_query_length>
                <visibility>4</visibility>
                <keyword>description,name,short_description,sku</keyword>
                <parse_name>1</parse_name>
                <stock_filter>1</stock_filter>
                <title_weight>5</title_weight>
                <description_weight>2</description_weight>
                <keywords_weight>1</keywords_weight>
                <sorting_method>keywords</sorting_method>
                <price_sorting_direction><![CDATA[<]]></price_sorting_direction>
            </search>
            <cronjob>
                <enable>0</enable>
                <cron_settings>0 3 * * *</cron_settings>
            </cronjob>
        </plugincompany_autocomplete>
    </default>
    <crontab>
        <jobs>
            <search_autocomplete_cache>
                <schedule>
                    <config_path>plugincompany_autocomplete/cronjob/cron_settings</config_path>
                </schedule>
                <run>
                    <model>plugincompany_autocomplete/cron::rebuildCache</model>
                </run>
            </search_autocomplete_cache>
        </jobs>
    </crontab>
</config>
